# Variables d'environnement — backend Express + SQLite (v2)

# Chemin vers la base de données SQLite (dans le volume Docker)
DATABASE_PATH=/usr/src/app/data/loan-calc.db

# Port d'écoute du serveur Express
API_PORT=3000

# OIDC (Authentik / Pocket ID ou tout provider compatible)
OIDC_ISSUER=https://auth.homelab.fr/application/o/loan-calc/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://loan-calc.homelab.fr/auth/callback

# Session Express (chaîne aléatoire d'au moins 32 caractères)
SESSION_SECRET=changeme_32chars_minimum
